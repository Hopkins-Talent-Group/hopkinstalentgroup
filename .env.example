# SMTP submission server (our VPS mail service, e.g. cPanel/Exim submission).
# All values are placeholders — copy to .env.local and fill in real values.
# Never commit real credentials.

# --- SMTP connection -------------------------------------------------------
# Mail server hostname (plain hostname, no spaces or special characters).
SMTP_HOST=mail.example.com

# TLS matrix (validated strictly by the app — see docs/inquiry-email.md):
#   Port 465: implicit TLS. Leave SMTP_SECURE unset or "true";
#             SMTP_REQUIRE_TLS must stay unset.
#   Port 587: STARTTLS with mandatory upgrade (the default port).
#             Leave SMTP_SECURE unset/"false"; SMTP_REQUIRE_TLS must stay
#             unset or "true". Plaintext on 587 is rejected.
#   Other ports (e.g. local Mailpit on 1025): BOTH flags are REQUIRED.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true

# AUTH credentials for a dedicated mailbox on our domain.
SMTP_USER=inquiries@example.com
SMTP_PASS=replace-with-smtp-password

# --- Fixed addresses (never taken from the client request) ------------------
CONTACT_FROM_EMAIL=inquiries@example.com
CONTACT_TO_EMAIL=owner-inbox@example.com

# --- Rate limiting (per client IP, in-memory, per server instance) ----------
# Invalid values fall back to the defaults below — they never silently
# disable protection. Set MAX to 0 only to deliberately disable.
# Defaults shown.
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MS=600000
