# SMTP submission server (our VPS mail service, e.g. cPanel/Exim submission).
# All values are placeholders — copy to .env.local and fill in real values.
# Never commit real credentials.

SMTP_HOST=mail.example.com
SMTP_PORT=587
# true for implicit TLS (usually port 465); false for STARTTLS (usually 587)
SMTP_SECURE=false
# Force TLS upgrade on plaintext ports (recommended: true)
SMTP_REQUIRE_TLS=true
SMTP_USER=inquiries@example.com
SMTP_PASS=replace-with-smtp-password

# Fixed addresses — never taken from the client request.
CONTACT_FROM_EMAIL=inquiries@example.com
CONTACT_TO_EMAIL=owner-inbox@example.com

# Optional per-client-IP rate limiting (defaults shown).
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MS=600000
